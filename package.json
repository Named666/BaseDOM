{
  "name": "basedom",
  "author": "named666",
  "version": "0.4.0",
  "description": "Small reactive UI library. Real DOM updates, no virtual DOM, no runtime dependencies.",
  "main": "./index.js",
  "type": "module",
  "files": [
    "components.js",
    "directives.js",
    "directives-core.js",
    "fetch-directives.js",
    "expression.js",
    "fetch.js",
    "form.js",
    "html.js",
    "index.js",
    "lifecycle.js",
    "navigation.js",
    "parser.js",
    "registry.js",
    "render.js",
    "router.js",
    "state.js",
    "store.js",
    "validation.js",
    "paths.js",
    "dev.js",
    "sfc.js",
    "sfc-compile.js",
    "vite/plugin.js",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./index.js",
    "./sfc.js": "./sfc.js",
    "./state.js": "./state.js",
    "./components.js": "./components.js",
    "./router.js": "./router.js",
    "./vite": "./vite/plugin.js"
  },
  "scripts": {
    "test": "node --import ./test/register-dom.js --test test/*.test.js",
    "example": "node scripts/serve-example.js",
    "example:build": "vite build --config examples/vite-counter/vite.config.js"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "^6.4.1"
  },
  "keywords": [
    "javascript",
    "frontend",
    "reactive",
    "ui",
    "vanilla-js",
    "spa",
    "router"
